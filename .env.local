# ローカルPostgreSQLデータベース設定
# デフォルト値を使用する場合は、これらの値をコメントアウトできます

LOCAL_DB_HOST=localhost
LOCAL_DB_NAME=appdb
LOCAL_DB_USER=cellio
LOCAL_DB_PASSWORD=cEllIo_process
LOCAL_DB_PORT=5432

# 使用方法:
# 1. PostgreSQLをローカルにインストール
# 2. データベース'screcounter'を作成: createdb screcounter
# 3. 必要に応じてユーザーとパスワードを設定
# 4. このファイルを.envにコピーして値を編集: cp .env.local .env
